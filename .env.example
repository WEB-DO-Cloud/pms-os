# Copy to .env and fill in. Never commit real secrets.
# Used by docker compose and local development.

# PostgreSQL (compose default matches the postgres service)
POSTGRES_USER=pms
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=pms_os
DATABASE_URL=postgresql://pms:change-me-postgres@postgres:5432/pms_os

# better-auth (generate a long random string, e.g. openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me-better-auth-secret
# Public origin of the PMS app (local example: http://localhost:3000)
BETTER_AUTH_URL=http://localhost:3000

# community = self-host one-time /setup; commercial = always-on /signup (multi-tenant)
PMS_EDITION=community

# Comma-separated emails for /super_admin SaaS console (commercial only)
SUPER_ADMIN_EMAILS=

# Encrypts Channex API keys / webhook secrets at rest (32+ bytes recommended)
SECRETS_ENCRYPTION_KEY=change-me-secrets-encryption-key

# Shared secret for worker → web internal sync routes (header: x-sync-internal-secret)
SYNC_INTERNAL_SECRET=change-me-sync-internal-secret

# Channex API base (staging default; production: https://channex.io/api/v1)
CHANNEX_API_BASE=https://staging.channex.io/api/v1

# Commercial only: one platform master Channex account. Tenants never enter a key —
# it is seeded per-network at runtime and scoped to each network's Channex group.
# Community leaves these blank and each network stores its own key under
# Settings → Integrations.
CHANNEX_API_KEY=
# Shared webhook secret Channex must send as `x-channex-webhook-secret`.
CHANNEX_WEBHOOK_SECRET=

# Stripe commercial billing (optional — page shows estimate-only without these).
# Create two recurring Prices in Stripe Dashboard: hotel and property tiers.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_HOTEL=
STRIPE_PRICE_PROPERTY=

# Public booking (HMAC quote tokens + Connect webhook, separate from SaaS billing)
QUOTE_TOKEN_SECRET=change-me-quote-token-secret
STRIPE_CONNECT_WEBHOOK_SECRET=
PUBLIC_BOOKING_ORIGIN=https://book.pms.do
NUXT_PUBLIC_PMS_API_BASE=https://app.pms.do

# Comma-separated network IDs the worker should pull/ack
SYNC_NETWORK_IDS=1

# Worker → web base URL (compose service name)
WEB_INTERNAL_URL=http://web:3000

# Optional: worker health file path inside the worker container
WORKER_HEALTH_FILE=/tmp/pms-worker-health.json

# Optional: pull/ack interval ms (default 30000)
SYNC_WORKER_INTERVAL_MS=30000

# xAI Grok via Vercel AI SDK (Rates yield, Reports forecast, Inbox drafts, Tasks ops).
# Feature is off until XAI_API_KEY is set. Set AI_ENABLED=false to force-disable.
XAI_API_KEY=
XAI_MODEL=grok-4.5
# AI_ENABLED=true

# Nuxt / Nitro
NUXT_HOST=0.0.0.0
NUXT_PORT=3000
NODE_ENV=production
